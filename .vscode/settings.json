{
  // ---- Explorer: hide build artifacts & clutter (files stay on disk) ----
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.class": true,
    "**/*.bak": true,
    "**/*.cpgz": true,
    "bin": true,
    "build": true,
    "out": true,
    "*.iml": true,
    ".idea": true
  },

  // ---- Search: skip huge data dirs (out=6.8G, BROKER DATASET=6.2G) ----
  "search.exclude": {
    "**/.venv": true,
    "**/out": true,
    "**/outputs": true,
    "**/BROKER DATASET": true,
    "**/Data": true,
    "**/nmr": true,
    "**/*.rar": true
  },

  // ---- File watcher: stop VS Code indexing ~13GB of data ----
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/out/**": true,
    "**/outputs/**": true,
    "**/BROKER DATASET/**": true,
    "**/Data/**": true,
    "**/nmr/**": true,
    "**/__pycache__/**": true
  },

  // ---- Pin the interpreter to this folder's venv ----
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // ---- Group related files under their source file ----
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.java": "${capture}.class, ${capture}$*.class, ${capture}.java.bak",
    "*.py": "${capture}.py.bak"
  },

  "explorer.sortOrder": "type",
  "cSpell.words": [
    "bruker",
    "nmrglue"
  ]
}
